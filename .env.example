# Copie para .env e ajuste. NUNCA commite o .env real.
# Em producao os segredos vem do ambiente, nao deste arquivo.

NODE_ENV=development

# Postgres do docker-compose
POSTGRES_USER=denisplace
POSTGRES_PASSWORD=denisplace
POSTGRES_DB=denisplace

# Portas proprias deste projeto: a maquina ja tem outros projetos usando 5432/6379/3000.
DATABASE_URL="postgresql://denisplace:denisplace@localhost:5434/denisplace?schema=public"

# BullMQ
REDIS_URL="redis://localhost:6390"

# Fuso usado em toda geracao de competencia/vencimento
APP_TIMEZONE=America/Sao_Paulo

# Dia padrao de vencimento dos titulos gerados pelo job
DEFAULT_VENCIMENTO_DIA=5

# Job mensal de cobranca: expressao cron do Celery-beat equivalente (BullMQ repeat)
COBRANCA_CRON="0 6 1 * *"

# Segredo para sessao/assinaturas. Gerar com: openssl rand -base64 32
# Auth.js recusa segredo com menos de 32 caracteres: o login falha com erro de configuração.
AUTH_SECRET="troque-este-valor-por-um-segredo-de-32-ou-mais-caracteres"

# Envio de e-mail do orcamento em PDF (Resend, sem SMTP pra configurar).
# https://resend.com -> criar conta, verificar dominio, gerar API key.
# Sem essas duas variaveis o botao "Enviar por e-mail" falha com mensagem clara.
RESEND_API_KEY=""
RESEND_FROM="Denis Place <orcamentos@seu-dominio-verificado.com.br>"

# Storage de comprovantes (S3-compativel). Em dev fica em disco local.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=sa-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
